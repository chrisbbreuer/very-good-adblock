{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "./buddy",
      "runtimeArgs": ["dev:frontend"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "extension-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--bun", "resources/scripts/preview-surfaces.ts"],
      "port": 8123
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8099", "--directory", "dist/site"],
      "port": 8099
    },
    {
      "name": "marketing-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--bun", "resources/scripts/serve-site.ts"],
      "port": 8124
    }
  ]
}
