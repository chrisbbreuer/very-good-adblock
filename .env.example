APP_NAME="Very Good Adblock"
APP_ENV=production
APP_KEY=base64:4aIQSzsvyZZ/3BHB3P+PiodLQqylqxWXonLYmWd1lug=
APP_DOMAIN=verygoodadblock.org
APP_URL=https://verygoodadblock.org

# Subscribe API (buddy serve:api → app/Models/Subscriber). SQLite by default.
DB_CONNECTION=sqlite
DB_DATABASE_PATH=database/verygoodadblock.sqlite

# DNS. `buddy deploy` does two things with these: it points the apex and www A
# records at the box it just deployed to, and it reconciles whatever config/dns.ts
# declares. Without them both are skipped with a warning, which is easy to miss in
# a long deploy log, so `bun run deploy` refuses to start unless they are set.
#
# The registrar is Porkbun. Generate a key at porkbun.com/account/api, then enable
# API access on the domain itself (Domain Management → verygoodadblock.org → API
# Access) — the key alone is not enough and the failure looks like a permissions
# error. The pair is `pk1_…` and `sk1_…`; the secret goes in PORKBUN_SECRET_KEY.
#
# Deploying somewhere without DNS on purpose: SKIP_DNS_CHECK=1 bun run deploy
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
