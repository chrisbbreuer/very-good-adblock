<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Very Good AdBlock</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="popup-shell">
    <main class="popup-frame" data-view="loading">
      <header class="popup-top">
        <span class="popup-brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Very Good AdBlock</span>
        </span>
        <button id="protection-toggle" class="power-switch" type="button" aria-label="Toggle protection" aria-pressed="true">
          <span class="power-switch-track" aria-hidden="true"><span class="power-switch-thumb"></span></span>
        </button>
      </header>

      <section id="safari-notice" class="safari-notice" hidden>
        <p class="safari-notice-text">
          <strong>Asked for permission on every site?</strong>
          <span>Safari asks once per site until you allow it everywhere. In the prompt, choose <b>Always Allow&hellip;</b> and then <b>Always Allow on Every Website</b>.</span>
        </p>
        <button id="safari-notice-dismiss" class="safari-notice-dismiss" type="button">Got it</button>
      </section>

      <section class="popup-hero" aria-label="This page">
        <div class="status-line">
          <span class="status-dot" aria-hidden="true"></span>
          <h1 id="site-title">Protection active</h1>
        </div>
        <button class="hero-count page-blocks-toggle" id="page-blocks-toggle" type="button" aria-expanded="false" aria-controls="page-blocks" title="Show what was blocked on this page">
          <strong id="page-blocked">0</strong>
          <span class="hero-count-label">
            <span><b>blocked</b> <span id="page-breakdown">on this page</span></span>
            <span class="page-blocks-chevron" aria-hidden="true">What was blocked <i>&#9662;</i></span>
          </span>
        </button>
        <div id="page-blocks" class="page-blocks" hidden></div>
      </section>

      <div id="pause-row" class="pause-row" hidden>
        <span id="pause-label" class="muted">Pause protection</span>
        <div class="pause-buttons">
          <button class="chip-button" data-pause="15" type="button">15m</button>
          <button class="chip-button" data-pause="30" type="button">30m</button>
          <button class="chip-button" data-pause="60" type="button">1h</button>
          <button id="resume-btn" class="chip-button accent" type="button" hidden>Resume now</button>
        </div>
      </div>

      <section class="popup-card savings-card" aria-label="Very Good AdBlock statistics">
        <div class="stat-strip">
          <div>
            <span>Data saved</span>
            <strong id="data-saved">0 KB</strong>
          </div>
          <div>
            <span>Video time</span>
            <strong id="video-time">0 min</strong>
          </div>
          <div>
            <span>All time</span>
            <strong id="lifetime-blocked">0</strong>
          </div>
        </div>
        <div class="chart-block">
          <div id="hourly-chart" class="bar-chart" role="list" aria-label="Blocked ads by hour"></div>
          <div class="timeline-footer">
            <span>Last 24 hours</span>
            <strong id="chart-peak">0 peak</strong>
          </div>
        </div>
      </section>

      <section class="popup-card site-block" aria-label="Current site">
        <div class="site-card-top">
          <div class="site-id">
            <img id="site-favicon" class="site-favicon" alt="" width="20" height="20" hidden>
            <div class="site-id-text">
              <strong id="current-site">No active tab</strong>
              <span id="site-last-activity" class="site-footnote">No current-site events yet.</span>
            </div>
          </div>
          <button id="site-toggle" class="site-toggle-button" type="button">Allow</button>
        </div>
        <div id="current-site-stats" class="site-stat-grid" aria-label="Current site statistics, all time">
          <div>
            <strong id="site-blocked">0</strong>
            <span>blocked</span>
          </div>
          <div>
            <strong id="site-data">0 KB</strong>
            <span>saved</span>
          </div>
          <div>
            <strong id="site-video">0 min</strong>
            <span>video</span>
          </div>
        </div>
      </section>

      <section class="category-list" aria-label="Top blocked sources">
        <div class="section-heading">
          <span>Top sources</span>
        </div>
        <div id="top-categories"></div>
      </section>

      <footer class="popup-actions">
        <button id="report-ad" class="report-button" type="button">
          <span class="report-text">
            <strong>Saw an ad slip through?</strong>
            <small id="report-hint">Report it in a pre-filled GitHub issue</small>
          </span>
        </button>
        <button id="open-options" class="dashboard-button" type="button" aria-label="Open dashboard">
          <span>Dashboard</span>
          <span aria-hidden="true">&#8599;</span>
        </button>
      </footer>

      <p id="status-message" class="status-message" role="status">Loading protection state...</p>
    </main>
    <script type="module" src="/popup.js"></script>
  </body>
</html>
